# Copy to .env and fill in. Never commit .env.
# Printer screen: Settings > Network (IP) and Settings > LAN (access code, serial).
BAMBU_HOST=192.168.1.50
BAMBU_SERIAL=YOUR_PRINTER_SERIAL
BAMBU_ACCESS_CODE=12345678
# Optional
BAMBU_STUDIO_PATH=C:\Program Files\Bambu Studio\bambu-studio.exe
BAMBU_WORK_DIR=C:\Users\you\bambu-mcp-output
# true = status, AMS, slicing, pause and stop only.
# Ignored under the Claude Code plugin: it sets BAMBU_READ_ONLY in the process
# environment (true unless you set it before starting Claude Code), and that wins.
BAMBU_READ_ONLY=true
# Only if your Bambu Studio names the P2S system presets differently:
# BAMBU_MACHINE_PRESET=Bambu Lab P2S 0.4 nozzle
# BAMBU_PROCESS_PRESET=0.20mm Standard @BBL P2S
# BAMBU_FILAMENT_PRESET_PLA=Bambu PLA Basic @BBL P2S
# BAMBU_FILAMENT_PRESET_PETG=Bambu PETG HF @BBL P2S
